<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg_cream">
    <TextView android:id="@+id/dow" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="11sp" android:textStyle="bold" android:textColor="#7A5C12" android:textAllCaps="true" android:letterSpacing="0.06" android:maxLines="1"/>
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <TextView android:id="@+id/day" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="46sp" android:textStyle="bold" android:textColor="#10243A" android:includeFontPadding="false"/>
    <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="13sp" android:textColor="#2B3E52" android:maxLines="2"/>
</LinearLayout>
